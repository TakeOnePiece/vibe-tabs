#!/bin/zsh
set -euo pipefail

SCRIPT_PATH="${0:A}"
PROJECT_ROOT="${SCRIPT_PATH:h:h}"
SESSION_COMMAND="$PROJECT_ROOT/bin/coding-session"

if [[ "${1-}" == "--app" || "${1-}" == "app" ]]; then
  if [[ -d "$PROJECT_ROOT/Coding Sessions.app" ]]; then
    exec /usr/bin/open "$PROJECT_ROOT/Coding Sessions.app"
  fi
  if [[ -d "$HOME/Applications/Coding Sessions.app" ]]; then
    exec /usr/bin/open "$HOME/Applications/Coding Sessions.app"
  fi
  print -u2 "Coding Sessions.app was not found. Run ./install.sh from the source checkout."
  exit 1
fi

if (( $# > 1 )); then
  print -u2 "Usage: coding-sessions [config.yml]"
  exit 1
fi

config_file="${1-}"
if [[ -z "$config_file" ]]; then
  if [[ -f "$HOME/.coding-sessions.yml" ]]; then
    config_file="$HOME/.coding-sessions.yml"
  elif [[ -f "$HOME/.coding-sessions.yaml" ]]; then
    config_file="$HOME/.coding-sessions.yaml"
  fi
fi
config_file="${config_file/#\~/$HOME}"

if [[ ! -f "$config_file" ]]; then
  print -u2 "No config found. Create ~/.coding-sessions.yml."
  exit 1
fi

yq_bin="$(command -v yq 2>/dev/null || true)"
jq_bin="$(command -v jq 2>/dev/null || true)"
[[ -n "$yq_bin" ]] || { print -u2 "Required command not found: yq"; exit 1; }
[[ -n "$jq_bin" ]] || { print -u2 "Required command not found: jq"; exit 1; }

config_json="$($yq_bin -o=json '.' "$config_file")"
version="$(print -r -- "$config_json" | $jq_bin -r '.version // 1')"
[[ "$version" == "1" ]] || { print -u2 "Unsupported config version: $version"; exit 1; }
print -r -- "$config_json" | $jq_bin -e '.sessions | type == "array"' >/dev/null || {
  print -u2 "Config must contain a sessions array."
  exit 1
}

while IFS= read -r session_json; do
  print -r -- "$session_json" | $jq_bin -e '
    (.name | type == "string" and length > 0) and
    (.path | type == "string" and length > 0) and
    (.layout | type == "string") and
    (.panes | type == "array" and length > 0 and all(.[]; type == "string" and length > 0)) and
    (.codex_args | type == "string")
  ' >/dev/null || {
    print -u2 "Invalid session entry: $session_json"
    exit 1
  }

  session_name="$(print -r -- "$session_json" | $jq_bin -r '.name')"
  session_path="$(print -r -- "$session_json" | $jq_bin -r '.path')"
  session_suffix="$(print -r -- "$session_json" | $jq_bin -r '.suffix')"
  session_layout="$(print -r -- "$session_json" | $jq_bin -r '.layout')"
  codex_args="$(print -r -- "$session_json" | $jq_bin -r '.codex_args')"
  pane_commands=("${(@f)$(print -r -- "$session_json" | $jq_bin -r '.panes[]')}")

  if [[ -n "$session_suffix" && "$session_name" != *-"$session_suffix" ]]; then
    session_name="$session_name-$session_suffix"
  fi

  CODING_SESSIONS_CODEX_ARGS="$codex_args" "$SESSION_COMMAND" --layout "$session_layout" "$session_name" "$session_path" "${pane_commands[@]}"
done < <(print -r -- "$config_json" | $jq_bin -c '
  .defaults as $defaults |
  .sessions[] |
  {
    name: .name,
    path: .path,
    suffix: (.session_suffix // $defaults.session_suffix // ""),
    layout: (.layout // $defaults.layout // "auto"),
    panes: (.panes // $defaults.panes // ["claude", "codex"]),
    codex_args: (.codex_args // $defaults.codex_args // "")
  }
')
