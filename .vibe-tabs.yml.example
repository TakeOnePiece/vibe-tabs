version: 1

defaults:
  session_suffix: laptop
  layout: auto
  terminal_profile: Pro
  agents:
    claude:
      dangerous: false
    codex:
      dangerous: false
    gemini:
      dangerous: false
  panes:
    - agent: claude
    - agent: codex

sessions:
  - name: web
    path: ~/Code/example-web

  - name: mobile
    path: ~/Code/example-mobile
    terminal_profile: Ocean
    panes:
      - agent: gemini
        dangerous: true
      - agent: codex

  - name: research
    path: ~/Code/research
    layout: tiled
    panes:
      - agent: claude
      - agent: pi
        dangerous: true
        dangerous_args: --dangerously-skip-permissions
      - command: aider --model deepseek/deepseek-chat
        title: deepseek
